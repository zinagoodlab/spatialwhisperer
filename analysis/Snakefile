# Canonical "trimodal" production model used for all paper-cited single-model evaluations.
PAPER_MAIN_MODEL = f"spatialwhisperer_{VARIANCE_DATASET_COMBO}"


rule paper_all:
    """
    Single target: produces every artefact cited in the manuscript and appendix.

    Composes the per-benchmark aggregate rules with the headline cross-benchmark
    plots and the skin / disease-stratification leaf outputs that don't have
    their own *_all wrapper yet. Run from inside analysis/:

        pixi run snakemake -j N paper_all
    """
    input:
        # ── Cross-benchmark headline plots ─────────────────────────────────────
        rules.spider_performance_plot.output.plot,
        rules.bimodal_bridge_plot.output.plot,
        rules.subset_performance_trend_grid.output.plot,
        expand(
            rules.cellwhisperer_per_class_analysis.output.analysis,
            allow_missing=True,
        ),

        # ── Per-benchmark aggregates ───────────────────────────────────────────
        rules.pathocell_all.input,
        rules.hest_benchmark_all.input,
        rules.spatialwhisperer_all.input,            # lung
        rules.cellwhisperer_benchmark_all.input,
        # subset_all is parameterised by {subratio}; the cross-ratio grid is already
        # in subset_performance_trend_grid above, so no need to expand subset_all here.
        rules.seed_analysis_all.input,
        rules.lambda_ablation_all.input,
        rules.freezing_encoder_appendix_all.input,
        rules.model_interpretation_all.input,

        # ── Benchmarks without an _all wrapper: list leaf outputs explicitly ──
        # Skin (Kriegsmann 16-class) — clinical labels, resize_crop preprocess.
        expand(
            rules.compute_skin_metrics.output.summary,
            model=[PAPER_MAIN_MODEL],
            labels=["clinical"],
            preprocess=["resize_crop"],
        ),
        # PanNuke disease stratification (per-tissue-type metrics, both subsets).
        expand(
            rules.compute_tissue_type_metrics.output.summary,
            model=[PAPER_MAIN_MODEL],
            subset=["all", "benign_only"],
        ),
    default_target: True


rule all:
    """Alias for paper_all (keeps `snakemake` with no target working)."""
    input:
        rules.paper_all.input,
