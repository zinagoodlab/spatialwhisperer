"""
Prompt Template Experiment for CRC PathoCellBench

Tests whether wrapping class labels in contextualizing sentences improves
zero-shot classification. Two templates are image-focused, two are
transcriptomics-focused. Run on our bimodal bridge model only.

Self-contained experiment. Reuses the main pipeline's prediction notebook
and metrics script.

Usage (on Sherlock, from within a SLURM job):
    conda activate cellwhisperer
    snakemake --profile sm7_slurm --cores 4 \
        -s analysis/experiments/prompt_engineering/Snakefile
"""

from pathlib import Path
import subprocess

include: "../../../shared/config.smk"

PROJECT_DIR = Path(
    subprocess.check_output("git rev-parse --show-toplevel", shell=True)
    .decode("utf-8")
    .strip()
)

configfile: PROJECT_DIR / "config.yaml"

EXPERIMENT_DIR = Path(workflow.basedir)

# ── Paths from main pipeline ─────────────────────────────────────────────────
PATHOCELL_RESULTS = PROJECT_DIR / "results/pathocell_evaluation"
PATHOCELL_DATA = PROJECT_DIR / "resources/pathocell"
PATHOCELL_MODEL_RESULTS = PATHOCELL_RESULTS / "{model}"

SEEDS = [0]

# Full CRC dataset list (109 datasets)
DATASETS = ["reg006_B", "reg014_B", "reg022_B", "reg030_A", "reg037_B", "reg046_A", "reg056_A", "reg007_A", "reg015_A", "reg023_A", "reg030_B", "reg038_A", "reg047_A", "reg058_A", "reg007_B", "reg016_A", "reg023_B", "reg031_A", "reg039_A", "reg048_A", "reg059_A", "reg001_A", "reg008_A", "reg016_B", "reg024_B", "reg031_B", "reg039_B", "reg048_B", "reg059_B", "reg001_B", "reg008_B", "reg017_A", "reg025_A", "reg032_A", "reg040_A", "reg049_A", "reg060_A", "reg002_A", "reg009_A", "reg017_B", "reg025_B", "reg032_B", "reg040_B", "reg050_A", "reg060_B", "reg002_B", "reg009_B", "reg018_A", "reg026_A", "reg033_A", "reg041_A", "reg050_B", "reg061_A", "reg003_A", "reg010_A", "reg018_B", "reg026_B", "reg033_B", "reg041_B", "reg051_A", "reg062_A", "reg003_B", "reg010_B", "reg019_A", "reg027_A", "reg034_A", "reg042_A", "reg051_B", "reg063_A", "reg004_A", "reg011_A", "reg020_A", "reg027_B", "reg035_A", "reg042_B", "reg052_A", "reg064_A", "reg004_B", "reg011_B", "reg020_B", "reg028_A", "reg035_B", "reg043_A", "reg052_B", "reg065_A", "reg005_A", "reg012_A", "reg021_A", "reg028_B", "reg036_A", "reg044_A", "reg053_A", "reg066_A", "reg005_B", "reg012_B", "reg021_B", "reg029_A", "reg036_B", "reg045_A", "reg054_A", "reg067_A", "reg006_A", "reg013_B", "reg022_A", "reg029_B", "reg037_A", "reg045_B", "reg055_A", "reg068_A"]

# ── Prompt template definitions ──────────────────────────────────────────────

CRC_CLASS_NAMES = [
    "Adipocytes", "B cells", "Background", "Dendritic cells", "Granulocytes",
    "Macrophages/Monocytes", "NK cells", "Nerves", "Other cells", "Plasma cells",
    "Smooth muscle", "Stroma", "T cells", "Tumor cells", "Vasculature/Lymphatics",
]

PROMPT_TEMPLATES = {
    "hne_tissue_image": "An H&E stained tissue image showing {label}",
    "histopath_image_of": "histopathology image of {label}",
    "tissue_sample_containing": "a tissue sample containing {label}",
    "gene_expression_profiling": "cells classified as {label} by gene expression profiling",
}

PROMPT_TEMPLATE_REMAPS = {
    tid: {c: tmpl.format(label=c) for c in CRC_CLASS_NAMES}
    for tid, tmpl in PROMPT_TEMPLATES.items()
}

MODEL = "spatialwhisperer_cellxgene_census__archs4_geo__hest1k"
TRIMODAL_CURATED_MODEL = "spatialwhisperer_cellxgene_census__archs4_geo__hest1k__quilt1m_curated"
BEST_TEMPLATE = "tissue_sample_containing"

# ── Rules ─────────────────────────────────────────────────────────────────────

rule all:
    input:
        # Full template comparison for bimodal bridge model (done)
        PATHOCELL_RESULTS / MODEL / "prompt_template_summary" / "patch_prompt_comparison.csv",
        # Best template only for trimodal curated model
        expand(
            PATHOCELL_RESULTS / "{model}" / "prompt_{prompt_id}_summary" / "patch_metrics_from_scores_aggregated.json",
            model=[TRIMODAL_CURATED_MODEL],
            prompt_id=[BEST_TEMPLATE],
        ),
    default_target: True


rule prompt_template_prediction:
    """
    Run CRC cell type prediction with a prompt-template-wrapped label set.
    Reuses the main pipeline's prediction notebook.
    """
    input:
        model=PROJECT_DIR / config["paths"]["jointemb_models"] / "{model}.ckpt",
        adata=PATHOCELL_DATA / "processed/{dataset}_{prediction_level}.h5ad",
        image=PATHOCELL_DATA / "processed/{dataset}_{prediction_level}.tiff",
    output:
        results=PATHOCELL_MODEL_RESULTS / "prompt_{prompt_id}/{dataset}_{prediction_level}_prediction_seed{seed}.json",
        per_class_metrics=PATHOCELL_MODEL_RESULTS / "prompt_{prompt_id}/{dataset}_{prediction_level}_per_class_seed{seed}.csv",
        confusion_matrix=PATHOCELL_MODEL_RESULTS / "prompt_{prompt_id}/{dataset}_{prediction_level}_confusion_seed{seed}.csv",
        scores=PATHOCELL_MODEL_RESULTS / "prompt_{prompt_id}/{dataset}_{prediction_level}_scores_seed{seed}.csv",
    params:
        prediction_level="{prediction_level}",
        label_remap=lambda wildcards: PROMPT_TEMPLATE_REMAPS[wildcards.prompt_id],
    threads: 8
    wildcard_constraints:
        prediction_level="(cell|patch)",
        dataset="[^/]+",
        seed="\\d+",
        prompt_id="[a-z_]+",
    conda:
        "cellwhisperer"
    resources:
        mem_mb=50000,
        slurm=slurm_gres("medium", num_cpus=8, time="2:00:00")
    log:
        notebook="logs/prompt_template_{model}_{prompt_id}_{dataset}_{prediction_level}_seed{seed}.ipynb"
    notebook:
        "../../notebooks/pathocell_cell_type_prediction.py.ipynb"


rule prompt_template_metrics:
    """
    Aggregate CRC metrics across all 109 datasets for one prompt template.
    """
    input:
        scores=lambda wildcards: expand(
            PATHOCELL_RESULTS / "{model}" / "prompt_{prompt_id}/{dataset}_{prediction_level}_scores_seed{seed}.csv",
            model=wildcards.model,
            prompt_id=wildcards.prompt_id,
            dataset=DATASETS,
            prediction_level=wildcards.prediction_level,
            seed=SEEDS,
        ),
        adatas=lambda wildcards: expand(
            PATHOCELL_DATA / "processed/{dataset}_{prediction_level}.h5ad",
            dataset=DATASETS,
            prediction_level=wildcards.prediction_level,
        ),
    output:
        aggregated=PATHOCELL_RESULTS / "{model}" / "prompt_{prompt_id}_summary" / "{prediction_level}_metrics_from_scores_aggregated.json",
        per_class=PATHOCELL_RESULTS / "{model}" / "prompt_{prompt_id}_summary" / "{prediction_level}_per_class_metrics_from_scores.csv",
        per_dataset=PATHOCELL_RESULTS / "{model}" / "prompt_{prompt_id}_summary" / "{prediction_level}_per_dataset_metrics_from_scores.csv",
        per_class_by_dataset=PATHOCELL_RESULTS / "{model}" / "prompt_{prompt_id}_summary" / "{prediction_level}_per_class_by_dataset_metrics_from_scores.csv",
    params:
        prediction_level="{prediction_level}",
    wildcard_constraints:
        prediction_level="(cell|patch)",
        model="[^/]+",
        prompt_id="[a-z_]+",
    conda:
        "cellwhisperer"
    resources:
        mem_mb=10000,
        slurm="cpus-per-task=1"
    script:
        "../../scripts/compute_pathocell_metrics_from_scores.py"


rule prompt_template_summary:
    """
    Collect aggregated metrics from all prompt templates + original into one CSV.
    """
    input:
        original=PATHOCELL_RESULTS / "{model}" / "summary" / "{prediction_level}_metrics_from_scores_aggregated.json",
        templates=expand(
            PATHOCELL_RESULTS / "{{model}}" / "prompt_{prompt_id}_summary" / "{{prediction_level}}_metrics_from_scores_aggregated.json",
            prompt_id=list(PROMPT_TEMPLATES.keys()),
        ),
    output:
        csv=PATHOCELL_RESULTS / "{model}" / "prompt_template_summary" / "{prediction_level}_prompt_comparison.csv",
    wildcard_constraints:
        prediction_level="(cell|patch)",
        model="[^/]+",
    conda:
        "cellwhisperer"
    resources:
        mem_mb=4000,
        slurm="cpus-per-task=1"
    script:
        "scripts/prompt_template_summary.py"
